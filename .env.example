# Copie para `.env` (que está no .gitignore) e ajuste os valores.
# Em desenvolvimento, a API funciona sem esse arquivo: `core/config.py` tem
# defaults seguros para rodar local.

# Segredo usado para assinar o JWT. Em produção, gerar com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-um-valor-aleatorio-longo
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Banco de dados (SQLModel/SQLAlchemy)
DATABASE_URL=sqlite:///fastapi/database.db

# CORS: allowlist explícita, separada por vírgula. Nunca usar "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting do POST /auth/token (formato do slowapi)
RATE_LIMIT_LOGIN=10/minute
